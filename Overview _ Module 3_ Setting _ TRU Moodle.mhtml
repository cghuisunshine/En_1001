 }

p.captionPhrase * { font-size: 1em; width: 80%; font-weight: inherit; }

li p.captionPhrase { width: 100%; }

p.hangingIndent { padding-left: 2em; text-indent: -2em; }

span.noBreak { white-space: nowrap; }

div.caseStudy { background-color: rgb(248, 248, 248); border: 1px solid rgb=
(213, 211, 196); margin: 2%; padding: 15px; }

div.blockQuote, div.signpost { margin: 4% 6% 4% 10%; }

cite.inlineCite { font-style: italic; }

code.codeInline { display: inline; font-size: 1em; font-weight: bold; white=
-space: normal; font-family: "courier new", courier, serif; color: rgb(174,=
 24, 24); }

.boldItalic { font-weight: bold; font-style: italic; }

